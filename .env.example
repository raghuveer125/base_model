# ======================================================================
# Trading_Plug&Play — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ======================================================================

# -------- Fyers API credentials --------
FYERS_CLIENT_ID=XXXXXX-100
FYERS_SECRET_KEY=REPLACE_ME
FYERS_REDIRECT_URI=https://127.0.0.1:8080/
FYERS_APP_ID=XXXXXX
FYERS_APP_TYPE=100
FYERS_FY_ID=ABC12345
FYERS_PIN=1234
FYERS_TOTP_SECRET=JBSWY3DPEHPK3PXP

# -------- Storage --------
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://tpp:tpp@localhost:5432/tpp

# -------- WAL --------
WAL_DIR=./wal
WAL_FSYNC_EVERY_N=50
WAL_MAX_FILE_MB=512

# -------- Logging --------
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_DIR=./logs

# -------- Market config --------
MARKET_TZ=Asia/Kolkata
INDICES=NIFTY50,BANKNIFTY,SENSEX
ATM_STRIKE_WINDOW=10
RETENTION_DAYS=2

# -------- WebSocket reliability --------
WS_RECONNECT_MAX_BACKOFF_S=60
WS_FREEZE_THRESHOLD_S=5
WS_GAP_MAX_SECONDS=10

# -------- Ingest pipeline --------
INGEST_QUEUE_MAXSIZE=50000
DEDUP_CACHE_SIZE=200000

# -------- Greeks engine --------
RISK_FREE_RATE=0.065
GREEKS_SPOT_TRIGGER_POINTS=2.0
GREEKS_CACHE_MAXSIZE=4096
