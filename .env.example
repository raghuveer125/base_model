# ======================================================================
# Trading_Plug&Play — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ======================================================================

# -------- Fyers API credentials --------
FYERS_CLIENT_ID=XXXXXX-100
FYERS_SECRET_KEY=REPLACE_ME
FYERS_REDIRECT_URI=https://127.0.0.1:8080/
FYERS_APP_ID=XXXXXX
FYERS_APP_TYPE=100
FYERS_FY_ID=ABC12345
FYERS_PIN=1234
FYERS_TOTP_SECRET=JBSWY3DPEHPK3PXP

# -------- Storage --------
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://tpp:tpp@localhost:5432/tpp

# -------- WAL --------
WAL_DIR=./wal
WAL_FSYNC_EVERY_N=50
WAL_MAX_FILE_MB=512

# -------- Logging --------
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_DIR=./logs

# -------- Market config --------
MARKET_TZ=Asia/Kolkata
INDICES=NIFTY50,BANKNIFTY,SENSEX
ATM_STRIKE_WINDOW=10
RETENTION_DAYS=2

# -------- WebSocket reliability --------
WS_RECONNECT_MAX_BACKOFF_S=60
WS_FREEZE_THRESHOLD_S=5
WS_GAP_MAX_SECONDS=10

# -------- Ingest pipeline --------
INGEST_QUEUE_MAXSIZE=50000
DEDUP_CACHE_SIZE=200000

# -------- Greeks engine --------
RISK_FREE_RATE=0.065
GREEKS_SPOT_TRIGGER_POINTS=2.0
GREEKS_CACHE_MAXSIZE=4096

# -------- Strategy framework --------
STRATEGIES_ENABLED=heartbeat
STRATEGY_COOLDOWN_SECONDS=300
STRATEGY_MAX_SIGNALS_PER_HOUR=20
STRATEGY_MAX_SIGNALS_PER_DAY=100
STRATEGY_SIGNAL_LOG_FILE=signals.jsonl

# -------- UI --------
UI_HOST=127.0.0.1
UI_PORT=8088

# -------- Health / alerting --------
HEALTH_METRICS_STALE_AFTER_S=30
HEALTH_WARN_LATENCY_P95_MS=500
HEALTH_CRIT_LATENCY_P95_MS=2000
HEALTH_WARN_GAPS=10
HEALTH_CRIT_GAPS=100
HEALTH_WARN_RECONNECTS=3
HEALTH_CRIT_RECONNECTS=10
HEALTH_WARN_STALENESS_S=15
HEALTH_CRIT_STALENESS_S=60

# -------- Notifications (Slack / Email / generic Webhook) --------
NOTIFY_ENABLED=false
NOTIFY_MIN_SEVERITY=crit           # warn | crit
NOTIFY_DEDUP_SECONDS=600
NOTIFY_POLL_SECONDS=30
NOTIFY_HISTORY_MAX=200

# Slack (incoming webhook)
SLACK_WEBHOOK_URL=

# SMTP (leave empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=                           # comma-separated recipient list

# Generic webhook (JSON POST with {subject, rule, severity, detail, ts_ms})
WEBHOOK_URL=
WEBHOOK_HEADERS_JSON=              # e.g. {"Authorization":"Bearer XXXX"}

# -------- Order engine (paper-first) --------
ORDERS_MODE=paper                  # paper | live (live not yet implemented)
PAPER_SLIPPAGE_BPS=10              # basis points worse-than-ref fill
PAPER_FEE_BPS=3                    # bps of notional
PAPER_FLAT_FEE=20.0                # per-trade flat fee (INR)
ORDERS_DEFAULT_QTY=1               # per-signal size if metadata.qty absent

# -------- Backups --------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
# pg_dump invocation template; {dsn} substitutes POSTGRES_DSN. Change to
# 'docker compose exec -T postgres pg_dump -U tpp tpp' if pg_dump isn't on PATH.
BACKUP_PG_DUMP_CMD=pg_dump -d "{dsn}" --no-owner --no-privileges
